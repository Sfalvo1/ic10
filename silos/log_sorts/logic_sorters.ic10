alias fe_sorter d0
alias c_sorter d1
alias cu_sorter d2
alias au_sorter d3
alias si_sorter d4
#alias _sorter d5

define fe_hash 1758427767
define c_hash  1724793494
define cu_hash -707307845
define au_hash -1348105509
define si_hash 1103972403

s fe_sorter Mode 1 # Any
s c_sorter  Mode 1
s cu_sorter Mode 1
s au_sorter Mode 1
s si_sorter Mode 1

# erase any stale instructions in RAM
#clr sorter 
clr fe_sorter
clr c_sorter
clr cu_sorter
clr au_sorter
clr si_sorter

sll r0 fe_hash 8
sll r1 c_hash 8
sll r2 cu_hash 8
sll r3 au_hash 8
sll r4 si_hash 8

or r0 r0 SorterInstruction.FilterPrefabHashEquals
or r1 r1 SorterInstruction.FilterPrefabHashEquals
or r2 r2 SorterInstruction.FilterPrefabHashEquals
or r3 r3 SorterInstruction.FilterPrefabHashEquals
or r4 r4 SorterInstruction.FilterPrefabHashEquals

put fe_sorter 0 r0
put c_sorter  0 r1
put cu_sorter 0 r2
put au_sorter 0 r3
put si_sorter 0 r4

#sll r0 steel 8
#or r0 r0 SorterInstruction.FilterPrefabHashEquals
#put sorter 0 r0