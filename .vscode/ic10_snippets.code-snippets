	"snippet_base": {
		"prefix": "snip base",
		"body": ["\"${1:label}\" : {",
				"\t\"scope\": \"\",",
				"\t\"prefix\": \"\",",
				"\t\"body\": \"\",",
				"\t\"description\":\"\"",
				"},"
			],
		"description":"snippet for making snippets",
	},

	"ic_main_func": {
		"scope": "ic10",
		"prefix": "main",
		"body": ["Main:",
				"",
				"j Main",
				],
		"description":"looping main function snippet including j to beginning",
	},

	 "func_mr" : {
	 	"scope": "ic10",
	 	"prefix": ["fmr", "func mr"],
	 	"body": ["${1:label}:",
				"",
				"j Main",
				],
	 	"description":"function that jumps to Main at the end"
	 },


	"iron ore hash":{
