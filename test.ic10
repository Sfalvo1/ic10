#Give devices alias and define parameters.
alias AirCon d0
alias PoweredVentCoolant d1
alias ACInput d2
alias GasAnalyzer d3
alias PipeAnalyzer d4

alias RoomTemp r0
alias CoolantTemp r1
alias CoolantPressure r2
alias TargetRoomTemp r3
alias MaxCoolantTemp r4
alias MaxCoolantPressure r5

move r3 293.15
move r4 303.15
move r5 49000

Main:
#Load parameters from sensors into registers
l r0 d3 Temperature
l r1 d4 Temperature
l r2 d4 Pressure
#Now we must branch to activate AC function
bgt r0 r3 ActivateAC
#Branch to activate coolant pump function. blt a<b
blt r1 r4 CoolantPumpActivate
blt r2 r5 CoolantPumpActivate
#Branch to flush coolant pipe function. bgt a > b
bgt r1 r4 FlushPump
bgt r2 r5 FlushPump
#Branch to Shutdown if target temp is reached.
blt r0 r3 ShutDown

yield
j Main

ActivateAC:
s d0 On 1
s d0 Mode 1
s d2 On 1
s d2 Mode 1
j Main

CoolantPumpActivate:
s d1 On 1
#Sets vent to inward
s d1 Mode 1
j Main

FlushPump:
s d1 On 1
#Sets vent to outward
s d1 Mode 0
yield
sleep 3
j Main

ShutDown:
s d0 On 0
s d2 On 0
j Main